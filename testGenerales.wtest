import armas2.*
import gladiador2.*


describe "Test de armas." {

    const armaFilo = new ArmaDeFilo(pesoArma=100,filo= 0,longitud= 30)
    //gladiador
    const mirmillon= new Mirmillon(arma=armaFilo,destreza=20,habilidad=50,puntos=20,fuerza=30,vida=80)
    const dimacheus= new Dimachaerus(arma= #{armaFilo},destreza=30,habilidad=50,armadura=casco,puntos=50)



    test "longitud = 30" {
        assert.equals(30, armaFilo.longitud())

    }
    test "pesoArma= 100" {
        assert.equals(100, armaFilo.pesoArma())
    
    }
    test "filo = 0" {
    assert.equals(0, armaFilo.filo())
    }
    test "valorDeAtaque() |Then: filo* longitud = 0*30" {
    assert.equals(0, armaFilo.valorDeAtaque())
    }
    test "mirmillon destreza()|Then. 15:" {
    assert.equals(15, mirmillon.destreza())
    }
    test "Mirmillon: method atacar(dimacheus)| Then: 50" {
    assert.equals(50, dimacheus.puntos())
    }
    test "mirmillon:defensa(portador) | Then. puntos armadura + destreza= 20" {
    assert.equals(25, mirmillon.defensa(self))
    }
}